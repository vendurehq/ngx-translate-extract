{
  "name": "@vendure/ngx-translate-extract",
  "version": "10.3.0",
  "description": "Extract strings from projects using ngx-translate",
  "author": "Kim Biesbjerg <kim@biesbjerg.com>",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node tools/build.js",
    "build:dev": "npm run clean && tsc",
    "watch": "npm run clean && tsc --watch",
    "clean": "tsc --build --clean",
    "test": "vitest",
    "test:matrix": "for v in 20 21 22; do npm install --no-save --no-package-lock @angular/compiler@$v && vitest run || exit 1; done; npm install",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint"
  },
  "dependencies": {
    "@phenomnomnominal/tsquery": "^6.2.0",
    "braces": "^3.0.3",
    "flat": "^6.0.1",
    "gettext-parser": "^9.1.1",
    "glob": "^13.0.6",
    "yargs": "^18.2.0"
  },
  "devDependencies": {
    "@angular/compiler": "^22.2.0",
    "@types/braces": "^3.0.5",
    "@types/gettext-parser": "^9.0.0",
    "@types/node": "^22.20.4",
    "@types/yargs": "^17.0.35",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "@angular/compiler": ">=20.0.0",
    "typescript": ">=5.8.0"
  },
  "bin": {
    "ngx-translate-extract": "cli.js"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/vendurehq/ngx-translate-extract.git"
  },
  "keywords": [
    "angular",
    "ionic",
    "ngx-translate",
    "extract",
    "extractor",
    "translate",
    "translation",
    "i18n",
    "gettext"
  ],
  "bugs": {
    "url": "https://github.com/vendurehq/ngx-translate-extract/issues"
  },
  "homepage": "https://github.com/vendurehq/ngx-translate-extract",
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  }
}
